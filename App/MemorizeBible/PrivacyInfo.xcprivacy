<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Design doc §13: no data collection of any kind, no tracking, no
	     third-party SDKs. This manifest is the machine-readable form of the
	     "Data Not Collected" App Store privacy label.

	     iCloud sync (§13.1) does not change that. The progress record is kept
	     in the user's own iCloud account, which Apple's definition of
	     collection excludes: it is never transmitted to the developer, and
	     there is no server on this side to receive it. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Progress is a JSON snapshot in Application Support; the
			     timestamps it reads and writes are the app's own. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- One key in UserDefaults: whether this device syncs to iCloud.
			     Read and written by the app itself and nothing else. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
